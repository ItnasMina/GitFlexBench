}
# ------------------------------------------------------------------------------
# 6. VISUALIZACIÓN: FRENTE DE PARETO (ESTABILIDAD VS SENSIBILIDAD)
# ------------------------------------------------------------------------------
grafica_pareto <- ggplot(df_probetas,
aes(x = GF_CV_Porc,
y = GF_Medio,
color = Infill,
shape = as.factor(Thickness_mm),
size = as.factor(Length_cm))) +
geom_point(alpha = 0.8, size = 4) +
geom_text(aes(label = `Specimen Name`), vjust = -1, size = 3, show.legend = FALSE) +
