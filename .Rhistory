summarise(
GF_Medio = mean(Test_GF_Medio, na.rm = TRUE),
GF_CV_Porc = mean(Test_GF_CV_Porc, na.rm = TRUE),
# Nuestras nuevas métricas de estabilización:
Resistencia_Base_Real = mean(Drift_Regimen_Permanente, na.rm = TRUE),
