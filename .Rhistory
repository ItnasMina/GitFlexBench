pivot_wider(names_from = Attribute, values_from = Value) %>%
mutate(
# Limpiamos textos para que R los entienda como números
Length_cm = as.numeric(gsub(" cm", "", Length)),
Thickness_mm = as.numeric(`Thickness (mm)`),
Width_cm = as.numeric(`Width (cm)`),
